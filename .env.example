# LoopzToken 本地开发环境变量（复制为 .env 后按需修改）
# 禁止将真实密钥、生产凭据提交到 Git。

# ---- 数据面基础设施（infra/docker/docker-compose.yml 提供本地实例）----
DATABASE_URL=postgresql://loopz:loopz@localhost:5432/loopztoken?schema=public
REDIS_URL=redis://localhost:6379

# ---- API Key HMAC pepper（生产存 KMS / Secret Manager，禁止入库、入 Git、入日志）----
API_KEY_PEPPER=dev-only-pepper-change-me

# ---- Go 服务 ----
GATEWAY_LISTEN_ADDR=:8080
BILLING_LISTEN_ADDR=:8081
BILLING_BASE_URL=http://localhost:8081

# ---- Control API ----
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3000
CONTROL_API_CORS_ORIGINS=http://localhost:5173

# ---- Web（仅允许公开配置，见 UI_TECH_STACK 18）----
VITE_CONTROL_API_URL=http://localhost:3000
VITE_PUBLIC_GATEWAY_URL=http://localhost:8080
VITE_APP_ENV=development
